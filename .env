# Backend URL (no trailing slash). Pick one, then restart with `npx expo start --clear`:
#   Phone with Expo Go (same Wi-Fi): http://<laptop LAN IP>:3000   (find it: ipconfig getifaddr en0)
#   iOS simulator / web:             http://localhost:3000
#   Android emulator:                http://10.0.2.2:3000
#   ngrok:                           https://<your-subdomain>.ngrok-free.app
EXPO_PUBLIC_API_URL=http://172.22.56.208:3000
# Socket.IO URL. Leave empty to use EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_SOCKET_URL=
# Minutes before a scheduled dose when TAKEN unlocks (must match backend TAKE_WINDOW_BEFORE_MINUTES)
EXPO_PUBLIC_TAKE_WINDOW_BEFORE_MINUTES=15
